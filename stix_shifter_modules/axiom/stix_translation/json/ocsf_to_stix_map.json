{
    "_time": [
        {"key": "first_observed", "cybox": false},
        {"key": "last_observed", "cybox": false}
    ],
    "class_uid": {"key": "x-oca-event.code", "object": "event", "transformer": "ToInteger"},
    "class_name": {"key": "x-oca-event.module", "object": "event"},
    "category_name": {"key": "x-oca-event.category", "object": "event"},
    "activity_name": {"key": "x-oca-event.action", "object": "event"},
    "status": {"key": "x-oca-event.outcome", "object": "event"},
    "message": {"key": "x-oca-event.x_message", "object": "event"},
    "device": {
        "hostname": [
            {"key": "x-oca-asset.hostname", "object": "host"},
            {"key": "x-oca-event.host_ref", "object": "event", "references": "host"}
        ],
        "ip": [
            {"key": "ipv4-addr.value", "object": "host_ip"},
            {"key": "x-oca-asset.ip_refs", "object": "host", "references": ["host_ip"]}
        ]
    },
    "src_endpoint": {
        "ip": [
            {"key": "ipv4-addr.value", "object": "src_ip"},
            {"key": "network-traffic.src_ref", "object": "nt", "references": "src_ip"}
        ],
        "port": {"key": "network-traffic.src_port", "object": "nt", "transformer": "ToInteger"},
        "hostname": {"key": "domain-name.value", "object": "src_domain"}
    },
    "dst_endpoint": {
        "ip": [
            {"key": "ipv4-addr.value", "object": "dst_ip"},
            {"key": "network-traffic.dst_ref", "object": "nt", "references": "dst_ip"},
            {"key": "x-oca-event.network_ref", "object": "event", "references": "nt"}
        ],
        "port": {"key": "network-traffic.dst_port", "object": "nt", "transformer": "ToInteger"},
        "hostname": {"key": "domain-name.value", "object": "dst_domain"}
    },
    "connection_info": {
        "protocol_name": {"key": "network-traffic.protocols", "object": "nt", "transformer": "ToLowercaseArray"}
    },
    "traffic": {
        "bytes_in": {"key": "network-traffic.dst_byte_count", "object": "nt", "transformer": "ToInteger"},
        "bytes_out": {"key": "network-traffic.src_byte_count", "object": "nt", "transformer": "ToInteger"}
    },
    "query": {
        "hostname": [
            {"key": "domain-name.value", "object": "query_domain"},
            {"key": "x-oca-event.domain_ref", "object": "event", "references": "query_domain"}
        ]
    },
    "http_request": {
        "url": {
            "url_string": {"key": "url.value", "object": "url"}
        }
    },
    "process": {
        "name": {"key": "process.name", "object": "proc"},
        "pid": {"key": "process.pid", "object": "proc", "transformer": "ToInteger"},
        "cmd_line": {"key": "process.command_line", "object": "proc"},
        "uid": {"key": "process.x_unique_id", "object": "proc"},
        "created_time": {"key": "process.created", "object": "proc", "transformer": "EpochToTimestamp"},
        "file": {
            "name": [
                {"key": "file.name", "object": "proc_file"},
                {"key": "process.binary_ref", "object": "proc", "references": "proc_file"},
                {"key": "x-oca-event.process_ref", "object": "event", "references": "proc"}
            ],
            "parent_folder": [
                {"key": "directory.path", "object": "proc_dir"},
                {"key": "file.parent_directory_ref", "object": "proc_file", "references": "proc_dir"}
            ],
            "hashes_by_algorithm": {
                "MD5": {"key": "file.hashes.MD5", "object": "proc_file"},
                "SHA-1": {"key": "file.hashes.SHA-1", "object": "proc_file"},
                "SHA-256": {"key": "file.hashes.SHA-256", "object": "proc_file"},
                "SHA-512": {"key": "file.hashes.SHA-512", "object": "proc_file"}
            }
        },
        "parent_process": {
            "name": [
                {"key": "process.name", "object": "parent_proc"},
                {"key": "process.parent_ref", "object": "proc", "references": "parent_proc"}
            ],
            "pid": {"key": "process.pid", "object": "parent_proc", "transformer": "ToInteger"},
            "cmd_line": {"key": "process.command_line", "object": "parent_proc"}
        },
        "user": {
            "name": [
                {"key": "user-account.user_id", "object": "proc_user"},
                {"key": "process.creator_user_ref", "object": "proc", "references": "proc_user"}
            ]
        }
    },
    "file": {
        "name": {"key": "file.name", "object": "file"},
        "size": {"key": "file.size", "object": "file", "transformer": "ToInteger"},
        "parent_folder": [
            {"key": "directory.path", "object": "file_dir"},
            {"key": "file.parent_directory_ref", "object": "file", "references": "file_dir"}
        ],
        "hashes_by_algorithm": {
            "MD5": {"key": "file.hashes.MD5", "object": "file"},
            "SHA-1": {"key": "file.hashes.SHA-1", "object": "file"},
            "SHA-256": {"key": "file.hashes.SHA-256", "object": "file"},
            "SHA-512": {"key": "file.hashes.SHA-512", "object": "file"}
        }
    },
    "actor": {
        "user": {
            "name": [
                {"key": "user-account.user_id", "object": "actor_user"},
                {"key": "x-oca-event.user_ref", "object": "event", "references": "actor_user"}
            ],
            "email_addr": {"key": "email-addr.value", "object": "actor_email"}
        }
    },
    "user": {
        "name": {"key": "user-account.user_id", "object": "user"},
        "uid": {"key": "user-account.x_uid", "object": "user"},
        "full_name": {"key": "user-account.display_name", "object": "user"},
        "email_addr": {"key": "email-addr.value", "object": "user_email"}
    }
}
